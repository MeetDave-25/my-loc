# --- required ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
PORT=3000

# --- public URL used in verification email links (defaults to the request host) ---
# PUBLIC_URL=https://whereabouts.example.com

# --- email (optional). Without SMTP_HOST, verification links are logged to the console. ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# MAIL_FROM=no-reply@example.com

# --- TLS (optional). If these files exist, the server serves HTTPS directly. ---
# In production prefer terminating TLS at a proxy and leaving these unset.
# SSL_KEY=certs/key.pem
# SSL_CERT=certs/cert.pem
